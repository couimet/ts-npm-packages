{
  "name": "@couimet/express-tools-testing",
  "version": "0.1.0",
  "description": "Test helper that starts an @couimet/express-tools app on an ephemeral port for route-level tests",
  "homepage": "https://github.com/couimet/ts-npm-packages/tree/main/packages/express-tools-testing#readme",
  "bugs": {
    "url": "https://github.com/couimet/ts-npm-packages/issues"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:couimet/ts-npm-packages.git",
    "directory": "packages/express-tools-testing"
  },
  "license": "MIT",
  "author": "Charles Ouimet <charles.ouimet@gmail.com>",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist coverage *.tsbuildinfo",
    "clean:all": "pnpm clean && rm -rf node_modules .eslintcache *.log",
    "clean:deps": "rm -rf node_modules",
    "format": "prettier --check .",
    "test": "jest --coverage",
    "typecheck": "tsc --noEmit"
  },
  "prettier": "@couimet/eslint-config/prettier",
  "devDependencies": {
    "@couimet/eslint-config": "workspace:*",
    "@couimet/express-tools": "workspace:*",
    "@couimet/logger-contract": "workspace:*",
    "@couimet/logger-contract-testing": "workspace:*",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "express": ">=5.2.1",
    "jest": "^29.7.0",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@couimet/express-tools": ">=0.1.0",
    "@couimet/logger-contract": ">=1.0.0",
    "express": ">=5.2.1"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  }
}
