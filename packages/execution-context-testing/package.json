    "@types/node": "^24.13.2",
    "eslint": "^10.4.1",
    "jest": ">=29.7.0",
    "prettier": "^3.8.4",
    "ts-jest": "^29.4.11",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  },
